{
  "transform": {
    "enabled": true,
    "continuous": true,
    "description": "Contract v3: lines per hour and group over the candidate and error indices, raw fields only (ADR-082 Decision 4).",
    "source_index": "polaris-logs-source",
    "target_index": "polaris-logs-aggregate",
    "page_size": 1000,
    "schedule": {
      "interval": {
        "period": 1,
        "unit": "Minutes"
      }
    },
    "groups": [
      {
        "date_histogram": {
          "source_field": "timestamp",
          "target_field": "window_start",
          "fixed_interval": "1h"
        }
      },
      {
        "terms": {
          "source_field": "hostName",
          "target_field": "hostName"
        }
      },
      {
        "terms": {
          "source_field": "level",
          "target_field": "level"
        }
      },
      {
        "terms": {
          "source_field": "http_method",
          "target_field": "http_method"
        }
      },
      {
        "terms": {
          "source_field": "http_status",
          "target_field": "http_status"
        }
      },
      {
        "terms": {
          "source_field": "user_principal_name",
          "target_field": "user_principal_name"
        }
      },
      {
        "terms": {
          "source_field": "api_path",
          "target_field": "api_path"
        }
      }
    ],
    "aggregations": {
      "lines": {
        "value_count": {
          "field": "timestamp"
        }
      },
      "response_bytes": {
        "sum": {
          "field": "response_size"
        }
      }
    }
  }
}
