{
  "index_patterns": [
    "polaris-logs-aggregate"
  ],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "dynamic": false,
      "_meta": {
        "contract_version": 3
      },
      "properties": {
        "window_start": {
          "type": "date"
        },
        "hostName": {
          "type": "keyword"
        },
        "level": {
          "type": "keyword"
        },
        "user_principal_name": {
          "type": "keyword"
        },
        "lines": {
          "type": "long"
        },
        "response_bytes": {
          "type": "long"
        },
        "http_method": {
          "type": "keyword"
        },
        "http_status": {
          "type": "long"
        },
        "api_path": {
          "type": "keyword"
        }
      }
    }
  }
}
