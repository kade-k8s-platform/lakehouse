{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polaris log contract v3: one candidate line",
  "description": "A record of the candidate index (polaris-logs-candidate-*), as the sidecar hands it to the main Fluent Bit: a line Polaris 1.6.0 wrote that policy-v5 routes to the candidate index, without loggerClassName, ndc, processName and processId, with the access-log fields parsed and the v3 fields added (docs/contracts/polaris-logs.md, ADR-081). sequence, threadName, threadId and mdc are optional and hostName is assumed: the syslog route is not yet measured.",
  "type": "object",
  "required": [
    "timestamp",
    "loggerName",
    "level",
    "message",
    "hostName",
    "user_principal_name",
    "event_id",
    "index_class",
    "policy_rule",
    "policy",
    "resource",
    "resource_kind",
    "api_kind",
    "status_class"
  ],
  "additionalProperties": true,
  "properties": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "loggerName": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "FATAL"
      ]
    },
    "message": {
      "type": "string"
    },
    "threadName": {
      "type": "string"
    },
    "threadId": {
      "type": "integer",
      "minimum": 0
    },
    "mdc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requestId": {
          "type": "string"
        },
        "realmId": {
          "type": "string"
        }
      }
    },
    "hostName": {
      "type": "string"
    },
    "client_ip": {
      "type": "string"
    },
    "user_principal_name": {
      "type": "string"
    },
    "http_method": {
      "type": "string"
    },
    "api_path": {
      "type": "string"
    },
    "http_status": {
      "type": "integer",
      "minimum": 0
    },
    "response_size": {
      "type": "integer",
      "minimum": 0
    },
    "access_log_parse_error": {
      "const": true
    },
    "secret_redacted": {
      "const": true
    },
    "exception": {
      "type": "object",
      "additionalProperties": true
    },
    "event_id": {
      "type": "string",
      "pattern": "^[^\\s]+$"
    },
    "index_class": {
      "const": "candidate"
    },
    "policy_rule": {
      "enum": [
        "2b",
        "3'",
        "4",
        "5"
      ]
    },
    "policy": {
      "const": "policy-v5"
    },
    "resource": {
      "type": "string"
    },
    "resource_kind": {
      "type": "string"
    },
    "api_kind": {
      "type": "string"
    },
    "status_class": {
      "type": "string",
      "enum": [
        "ok",
        "401",
        "403",
        "404",
        "4xx",
        "5xx",
        "unparsed",
        "none"
      ]
    }
  }
}
