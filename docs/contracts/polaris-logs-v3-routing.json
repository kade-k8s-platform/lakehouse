{
  "description": "Policy-v5 routing for contract v3 (docs/contracts/polaris-logs.md, ADR-082 Decision 2): twelve rows of built-in Fluent Bit filters (parser, grep, rewrite_tag), first match wins by order; a kept record ends in a final tag (polaris.access and polaris.post are intermediate, a grep with Exclude drops); the sidecar adds no derived field and does not redact (ADR-082 Decision 3). scripts/test_polaris_logs_contract.py keeps the rows equal to the ADR's table. The tag spellings are placeholders the ADR names; this contract fixes them so the sidecar emits exactly these. Rule 2b -> candidate and rule 7 -> error are placeholder choices of ADR-081.",
  "policy": "policy-v5",
  "rows": [
    {
      "id": "1",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris",
          "key": "level",
          "regex": "^(ERROR|WARN)$",
          "action": "rewrite",
          "to": "polaris.error.r1"
        }
      ]
    },
    {
      "id": "access line",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris",
          "key": "loggerName",
          "regex": "^io\\.quarkus\\.http\\.access-log$",
          "action": "rewrite",
          "to": "polaris.access"
        }
      ]
    },
    {
      "id": "2b",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris",
          "key": "loggerName",
          "regex": "^org\\.apache\\.polaris\\.service\\.(exception\\.IcebergExceptionMapper|admin\\.PolarisServiceImpl)$",
          "action": "rewrite",
          "to": "polaris.candidate.r2b"
        }
      ]
    },
    {
      "id": "2a, 2c",
      "stages": [
        {
          "filter": "grep",
          "match": "polaris",
          "key": "loggerName",
          "regex": ".+",
          "action": "exclude",
          "to": "dropped"
        }
      ]
    },
    {
      "id": "7",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris",
          "key": "message",
          "regex": ".+",
          "action": "rewrite",
          "to": "polaris.error.r7"
        }
      ]
    },
    {
      "id": "access: parse",
      "stages": [
        {
          "filter": "parser",
          "match": "polaris.access",
          "key": "message",
          "regex": null,
          "action": "parse",
          "to": null
        }
      ]
    },
    {
      "id": "3'",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris.access",
          "key": "http_status",
          "regex": "^404$",
          "action": "rewrite",
          "to": "polaris.candidate.r3p"
        }
      ]
    },
    {
      "id": "3",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris.access",
          "key": "http_status",
          "regex": "^[45][0-9][0-9]$",
          "action": "rewrite",
          "to": "polaris.error.r3"
        }
      ]
    },
    {
      "id": "4",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris.access",
          "key": "http_method",
          "regex": "^(PUT|DELETE|PATCH)$",
          "action": "rewrite",
          "to": "polaris.candidate.r4"
        }
      ]
    },
    {
      "id": "6",
      "stages": [
        {
          "filter": "grep",
          "match": "polaris.access",
          "key": "http_method",
          "regex": "^(GET|HEAD)$",
          "action": "exclude",
          "to": "dropped"
        }
      ]
    },
    {
      "id": "5 and other POST",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris.access",
          "key": "http_method",
          "regex": "^POST$",
          "action": "rewrite",
          "to": "polaris.post"
        },
        {
          "filter": "rewrite_tag",
          "match": "polaris.post",
          "key": "api_path",
          "regex": "^/api/management/",
          "action": "rewrite",
          "to": "polaris.candidate.r5"
        },
        {
          "filter": "grep",
          "match": "polaris.post",
          "key": "api_path",
          "regex": ".+",
          "action": "exclude",
          "to": "dropped"
        }
      ]
    },
    {
      "id": "3 (unparsed), 7 (other method)",
      "stages": [
        {
          "filter": "rewrite_tag",
          "match": "polaris.access",
          "key": "message",
          "regex": ".+",
          "action": "rewrite",
          "to": "polaris.error.r7"
        }
      ]
    }
  ],
  "tags": {
    "1": "polaris.error.r1",
    "2b": "polaris.candidate.r2b",
    "3'": "polaris.candidate.r3p",
    "3": "polaris.error.r3",
    "4": "polaris.candidate.r4",
    "5": "polaris.candidate.r5",
    "7": "polaris.error.r7"
  },
